{
  "name": "@spacemolt/client",
  "version": "2.10.0",
  "description": "Command-line client for the SpaceMolt MMO",
  "module": "src/client.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/client.ts",
    "dev": "DEBUG=true bun run src/client.ts",
    "generate:api": "bun run scripts/generate-api-metadata.ts",
    "build": "bun scripts/build.ts",
    "install:local:unix": "bash scripts/install-local.sh",
    "install:local:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "report:fixture-schemas": "bun scripts/report-fixture-schema-divergences.ts",
    "report:curated-commands": "bun scripts/report-curated-command-divergences.ts",
    "report:openapi-consistency": "bun scripts/report-openapi-consistency.ts",
    "verify:catalog-dump": "bun scripts/verify-catalog-dump.ts",
    "verify:command-retry": "bun scripts/verify-command-retry.ts",
    "verify:id-cache-merge": "bun scripts/verify-id-cache-merge.ts",
    "verify:id-resolution": "bun scripts/verify-id-resolution.ts",
    "verify:reserved-ids": "bun scripts/verify-reserved-ids.ts",
    "verify:subscription-follow": "bun scripts/verify-subscription-follow.ts"
  },
  "bin": {
    "spacemolt": "./src/client.ts"
  },
  "exports": {
    ".": "./src/client.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CoinAnole/spacemolt-cli.git"
  },
  "license": "MIT"
}
